local Utils = {}

function Utils.GetTextGradient(text, startColor, endColor, fontSize)
    local result = ""
    local length = utf8.len(text)
    if not length then return text end

    local i = 0
    for _, code in utf8.codes(text) do
        local char = utf8.char(code)
        local t = i / math.max(length - 1, 1)
        local r = startColor.R + (endColor.R - startColor.R) * t
        local g = startColor.G + (endColor.G - startColor.G) * t
        local b = startColor.B + (endColor.B - startColor.B) * t
        if fontSize then
            result = result .. string.format(
                '<font color="rgb(%d,%d,%d)" size="%d">%s</font>',
                math.floor(r * 255), math.floor(g * 255), math.floor(b * 255), fontSize, char
            )
        else
            result = result .. string.format(
                '<font color="rgb(%d,%d,%d)">%s</font>',
                math.floor(r * 255), math.floor(g * 255), math.floor(b * 255), char
            )
        end
        i = i + 1
    end
    return result
end

