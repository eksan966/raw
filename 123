local function getCharacterRoot()
    local character = player.Character
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart")
end

local function startAutoHarvest()
    if _harvestThread then return end

    _harvestThread = task.spawn(function()
        while hubRunning and AutoHarvestActive do
            local clickEvent = ReplicatedStorage.remoteFunctions
                and ReplicatedStorage.remoteFunctions.toolClick
            if not clickEvent then
                warn("[自动采蜜] 找不到 toolClick 远程事件")
                AutoHarvestActive = false
                break
            end

            pcall(function()
                clickEvent:InvokeServer()
            end)

            task.wait(0.1)
        end
        _harvestThread = nil
    end)
end

local function stopAutoHarvest()
    AutoHarvestActive = false
end

local function remoteMakeHoney()
    local event = ReplicatedStorage.remoteEvents and ReplicatedStorage.remoteEvents.makeHoney
    if not event then
        warn("[远程酿蜜] 找不到 makeHoney 远程事件")
        return
    end
    pcall(function()
        event:FireServer()
    end)
end

local DROP_FOLDER_NAMES = {
    "Drops",
    "DropItems",
    "DroppedItems",
    "Loot",
    "Pickups",
    "Collectibles",
}

local DROP_NAME_KEYWORDS = {
    "drop",
    "loot",
    "pickup",
    "collect",
    "coin",
    "cash",
    "money",
    "item",
    "orb",
    "gem",
}

local function getOwnerPlayer(instance)
    local current = instance
    while current and current ~= workspace do
        if current:IsA("Model") then
            local owner = Players:GetPlayerFromCharacter(current)
            if owner then
                return owner
            end
        end

        if current:IsA("Backpack") and current.Parent and current.Parent:IsA("Player") then
            return current.Parent
        end

        current = current.Parent
    end
    return nil
end

local function isOtherPlayerOwned(instance)
    local owner = getOwnerPlayer(instance)
    return owner ~= nil and owner ~= player
end

local function isOnAnyPlayer(instance)
    return getOwnerPlayer(instance) ~= nil
end

local function isDropCandidate(instance)
    if not instance or not instance.Parent then
        return false
    end

    if isOnAnyPlayer(instance) then
        return false
    end

    if instance:IsA("Tool") then
        return false
    end

    if instance:IsA("Accessory") then
        return false
    end

    if instance:IsA("Model") then
        if instance:FindFirstChildOfClass("Humanoid") then
            return false
        end

        local primary = instance.PrimaryPart or instance:FindFirstChildWhichIsA("BasePart", true)
        return primary ~= nil
    end

    if instance:IsA("BasePart") and not instance:IsA("Terrain") then
        if instance:FindFirstChild("TouchInterest") then
            return true
        end

        local parent = instance.Parent
        if parent and parent:IsA("Model") and not parent:FindFirstChildOfClass("Humanoid") then
            return true
        end
    end

    return false
end

local function getDropPart(instance)
    if instance:IsA("BasePart") then
        return instance
    end

    if instance:IsA("Model") then
        return instance.PrimaryPart or instance:FindFirstChildWhichIsA("BasePart", true)
    end

    return nil
end

local function matchesDropKeyword(name)
    local lowerName = string.lower(name or "")
    for _, keyword in ipairs(DROP_NAME_KEYWORDS) do
        if string.find(lowerName, keyword, 1, true) then
            return true
        end
    end
    return false
end

local function collectDropPart(root, dropPart)
    if not root or not dropPart then return false end

    local collected = false

    if dropPart:FindFirstChild("TouchInterest") then
        pcall(function()
            firetouchinterest(root, dropPart, 0)
            task.wait(0.05)
            firetouchinterest(root, dropPart, 1)
        end)
        collected = true
    end

    for _, descendant in ipairs(dropPart:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") and descendant.Enabled then
            pcall(function()
                fireproximityprompt(descendant)
            end)
            collected = true
        end
    end

    local parentModel = dropPart:FindFirstAncestorOfClass("Model")
    if parentModel then
        for _, descendant in ipairs(parentModel:GetDescendants()) do
            if descendant:IsA("ProximityPrompt") and descendant.Enabled then
                pcall(function()
                    fireproximityprompt(descendant)
                end)
                collected = true
            end
        end
    end

    if not collected then
        root.CFrame = dropPart.CFrame + Vector3.new(0, 2, 0)
        task.wait(0.05)
        if dropPart:FindFirstChild("TouchInterest") then
            pcall(function()
                firetouchinterest(root, dropPart, 0)
                task.wait(0.05)
                firetouchinterest(root, dropPart, 1)
            end)
            collected = true
        end
    end

    return collected
end

local function getNearbyDrops(maxDistance)
    local root = getCharacterRoot()
    if not root then return {} end

    local myPos = root.Position
    local drops = {}
    local seen = {}

    local function tryAdd(instance)
        if isOtherPlayerOwned(instance) then return end
        if not isDropCandidate(instance) then return end

        local dropPart = getDropPart(instance)
        if not dropPart or seen[dropPart] then return end
        if isOtherPlayerOwned(dropPart) then return end

        local distance = (dropPart.Position - myPos).Magnitude
        if distance > maxDistance then return end

        seen[dropPart] = true
        table.insert(drops, {
            part = dropPart,
            distance = distance,
        })
    end

    for _, folderName in ipairs(DROP_FOLDER_NAMES) do
        local folder = workspace:FindFirstChild(folderName)
        if folder then
            for _, child in ipairs(folder:GetDescendants()) do
                if child:IsA("BasePart") or child:IsA("Model") then
                    tryAdd(child)
                end
            end
        end
    end

    for _, descendant in ipairs(workspace:GetDescendants()) do
        if descendant:IsA("BasePart") and descendant:FindFirstChild("TouchInterest") then
            tryAdd(descendant)
        elseif descendant:IsA("Model") and matchesDropKeyword(descendant.Name) then
            tryAdd(descendant)
        elseif descendant:IsA("BasePart") and matchesDropKeyword(descendant.Name) then
            tryAdd(descendant)
        end
    end

    table.sort(drops, function(a, b)
        return a.distance < b.distance
    end)

    return drops
end

local function startAutoCollectDrops()
    if _collectDropsThread then return end

    _collectDropsThread = task.spawn(function()
        while hubRunning and AutoCollectDropsActive do
            local root = getCharacterRoot()
            if root then
                local drops = getNearbyDrops(120)
                for _, dropInfo in ipairs(drops) do
                    if not AutoCollectDropsActive then break end
                    collectDropPart(root, dropInfo.part)
                    task.wait(0.1)
                end
            end
            task.wait(0.5)
        end
        _collectDropsThread = nil
    end)
end

local function stopAutoCollectDrops()
    AutoCollectDropsActive = false
end

