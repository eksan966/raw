function UIEffects.InitBorder(window)
    local mainFrame = window and window.UIElements and window.UIElements.Main
    if not mainFrame then return end

    if not mainFrame:FindFirstChildOfClass("UICorner") then
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 16)
        corner.Parent = mainFrame
    end

    local stroke = mainFrame:FindFirstChild("FlowBorder") or Instance.new("UIStroke")
    stroke.Name = "FlowBorder"
    stroke.Thickness = UIEffects.BorderThickness
    stroke.Color = Color3.new(1, 1, 1)
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.LineJoinMode = Enum.LineJoinMode.Round
    stroke.Parent = mainFrame

    local gradient = stroke:FindFirstChild("StreamEffect") or Instance.new("UIGradient")
    gradient.Name = "StreamEffect"
    gradient.Color = UIEffects.Theme
    gradient.Parent = stroke

    if UIEffects.Connection then UIEffects.Connection:Disconnect() end
    local borderAccum = 0
    UIEffects.Connection = RunService.Heartbeat:Connect(function(dt)
        if not stroke.Parent then
            UIEffects.Connection:Disconnect()
            return
        end
        borderAccum = borderAccum + dt
        if borderAccum < 0.05 then return end
        borderAccum = 0
        gradient.Rotation = (tick() * UIEffects.FlowSpeed * 20) % 360
    end)
end

